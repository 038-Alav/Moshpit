# API (native Windows/Linux development)
DATABASE_URL=postgresql://moshpit:moshpit_dev@localhost:5432/moshpit
API_HOST=0.0.0.0
API_PORT=3000

# Centrifugo local development
CENTRIFUGO_BIN=
CENTRIFUGO_URL=http://localhost:8000
CENTRIFUGO_API_KEY=local-dev-api-key-change-before-use
CENTRIFUGO_TOKEN_HMAC_SECRET_KEY=local-dev-token-secret-change-before-use

# PostgreSQL defaults used by the optional Docker/Podman Compose stack
POSTGRES_DB=moshpit
POSTGRES_USER=moshpit
POSTGRES_PASSWORD=moshpit_dev

# Web
WEB_ORIGIN=http://localhost:5173
